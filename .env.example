# ==================================================
# DTA Sistemas — Variables de entorno
# ==================================================
# Copiar a .env.local (desarrollo) y configurar los valores reales en
# Vercel → Project Settings → Environment Variables para Preview y
# Production por separado (ver docs/deployment.md).
#
# NEXT_PUBLIC_* se envían al navegador — nunca poner un secreto ahí.
# Las demás son server-only y solo existen en el servidor/build.
# ==================================================

# --- Anti-spam (Fase 7) ---
# Cloudflare Dashboard → Turnstile → crear sitio → copiar ambas keys.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Notificación de leads por correo — Resend (https://resend.com) ---
# 1) Crea cuenta en Resend y verifica tu dominio (registros DNS) en Domains.
# 2) Crea una API key (Permission: "Sending access") y pégala abajo.
# En PRODUCCIÓN, si falta EMAIL_PROVIDER_API_KEY el formulario devuelve error
# (antes aparentaba éxito y el lead se perdía). En desarrollo solo avisa en consola.
EMAIL_PROVIDER_API_KEY=
# Destinatario(s) de los leads; varios separados por coma.
LEADS_NOTIFICATION_EMAIL=contacto@dtasistemas.com
# Remitente de ambos correos (aviso al equipo y confirmación al cliente): debe
# pertenecer a un dominio verificado en Resend.
# Para pruebas sin dominio puedes usar "DTA Sistemas <onboarding@resend.dev>"
# (Resend solo entrega a tu propio correo de cuenta en ese modo).
LEADS_FROM_EMAIL=DTA Sistemas <leads@dtasistemas.com>

# --- CRM (Fase 7) ---
# CRM de destino pendiente de confirmar (HubSpot / Pipedrive / propio) —
# ver lib/leads/syncToCrm.ts.
CRM_API_KEY=

# --- Analytics (Fase 8) ---
# GA4: Google Analytics → Admin → Flujos de datos → Measurement ID (G-XXXXXXXXXX)
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
# GTM: opcional — Google Tag Manager → ID del contenedor (GTM-XXXXXXX).
# Ver advertencia en components/analytics/GoogleTagManager.tsx: no
# configurar una tag de GA4 dentro de este contenedor si ya existe
# NEXT_PUBLIC_GA4_MEASUREMENT_ID, para evitar contar cada evento dos veces.
NEXT_PUBLIC_GTM_CONTAINER_ID=

# --- Search Console (Fase 8) ---
# Search Console → Agregar propiedad → método "Etiqueta HTML" → copiar
# solo el valor del atributo content del meta tag.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Rate limiting (Fase 10) ---
# Opcional — solo si se migra lib/security/rateLimit.ts a Upstash Redis
# para producción multi-instancia (ver comentario en ese archivo).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
